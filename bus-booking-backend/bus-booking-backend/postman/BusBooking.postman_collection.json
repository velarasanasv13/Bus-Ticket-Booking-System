{
  "info": {
    "name": "Bus Booking API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "busId",
      "value": "1"
    },
    {
      "key": "bookingId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1 Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Asha K\",\n  \"email\": \"asha@example.com\",\n  \"password\": \"secret123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "2 Login (User)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"asha@example.com\",\n  \"password\": \"secret123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "2b Login (Admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@routewise.in\",\n  \"password\": \"Str0ng!Pass\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('adminToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "3 List buses",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/buses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "buses"
          ]
        }
      }
    },
    {
      "name": "4 Get bus",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/buses/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "buses",
            "1"
          ]
        }
      }
    },
    {
      "name": "5 Search buses",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/buses/search?source=Chennai&destination=Bengaluru&date=2026-12-05",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "buses",
            "search"
          ],
          "query": [
            {
              "key": "source",
              "value": "Chennai"
            },
            {
              "key": "destination",
              "value": "Bengaluru"
            },
            {
              "key": "date",
              "value": "2026-12-05"
            }
          ]
        }
      }
    },
    {
      "name": "6 Add bus (ADMIN)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/buses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "buses"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"busNumber\": \"TN-10-XY-1001\",\n  \"operatorName\": \"Kaveri Express\",\n  \"source\": \"Chennai\",\n  \"destination\": \"Bengaluru\",\n  \"departureDateTime\": \"2026-12-05T22:30:00\",\n  \"arrivalDateTime\": \"2026-12-06T05:00:00\",\n  \"totalSeats\": 40,\n  \"farePerSeat\": 899.0\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code===201){pm.collectionVariables.set('busId', pm.response.json().id);}"
            ]
          }
        }
      ]
    },
    {
      "name": "7 Update bus (ADMIN)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/buses/{{busId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "buses",
            "{{busId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"busNumber\": \"TN-10-XY-1001\",\n  \"operatorName\": \"Kaveri Express\",\n  \"source\": \"Chennai\",\n  \"destination\": \"Bengaluru\",\n  \"departureDateTime\": \"2026-12-05T22:30:00\",\n  \"arrivalDateTime\": \"2026-12-06T05:00:00\",\n  \"totalSeats\": 40,\n  \"farePerSeat\": 950.0\n}"
        }
      }
    },
    {
      "name": "8 Delete bus (ADMIN)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/buses/{{busId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "buses",
            "{{busId}}"
          ]
        }
      }
    },
    {
      "name": "9 Create booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/bookings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookings"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"busId\": 1,\n  \"passengerName\": \"Asha K\",\n  \"passengerAge\": 29,\n  \"seatNumbers\": [\n    7,\n    8\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code===201){pm.collectionVariables.set('bookingId', pm.response.json().id);}"
            ]
          }
        }
      ]
    },
    {
      "name": "10 My bookings",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/bookings/my",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookings",
            "my"
          ]
        }
      }
    },
    {
      "name": "11 Get booking",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/bookings/{{bookingId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookings",
            "{{bookingId}}"
          ]
        }
      }
    },
    {
      "name": "12 Update booking",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/bookings/{{bookingId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookings",
            "{{bookingId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"passengerName\": \"Asha Kumar\",\n  \"passengerAge\": 30\n}"
        }
      }
    },
    {
      "name": "13 Cancel booking (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/cancel",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookings",
            "{{bookingId}}",
            "cancel"
          ]
        }
      }
    },
    {
      "name": "14 Cancel booking (DELETE alias)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/bookings/{{bookingId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookings",
            "{{bookingId}}"
          ]
        }
      }
    }
  ]
}